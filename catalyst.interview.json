  "evidenceQuestions": {
    "note": "Questions about what the live checks actually found, asked only when the check found it. Conditions read FACTS derived from the mini's background checks; an unknown fact is always false, so a check that failed, timed out or returned nothing simply removes the question. Nothing here is ever asked blind, and the interview is complete and coherent without a single one of them. Order is priority order, at most one question per group, capped at maxPerInterview.",
    "maxPerInterview": 2,
    "facts": {
      "google_profile": "\"found\" or \"missing\", from the Google Business check",
      "review_count": "number of Google reviews found",
      "google_rating": "star rating found, if any",
      "ranks_page_one": "true / false, whether the check saw them on page one",
      "website_status": "\"up\" or \"down\", from the website check",
      "website_load_seconds": "how long the site took to open for the check",
      "click_to_call": "true / false, whether the site had a tap-to-call number",
      "ai_listed": "true / false, whether the assistant check returned their name"
    },
    "questions": [
      {
        "id": "reviews_none",
        "kind": "single",
        "kicker": "What Sage found",
        "question": "Sage found your Google profile, and no reviews on it yet. Do you ask customers for one?",
        "hint": "Sage ran this check while you were answering the last few.",
        "group": "reviews",
        "when": {
          "all": [
            {
              "fact": "google_profile",
              "op": "eq",
              "value": "found"
            },
            {
              "fact": "review_count",
              "op": "eq",
              "value": 0
            }
          ]
        },
        "options": [
          {
            "value": "every_time",
            "label": "Yes, every job"
          },
          {
            "value": "sometimes",
            "label": "Sometimes, when I remember"
          },
          {
            "value": "never",
            "label": "No, we have never asked"
          },
          {
            "value": "ask_no_luck",
            "label": "We ask, most people don't leave one"
          },
          {
            "value": "not_sure",
            "label": "Not sure",
            "escape": true
          }
        ]
      },
      {
        "id": "reviews_thin",
        "kind": "single",
        "kicker": "What Sage found",
